{
  "name": "obsidian-vault-keeper",
  "version": "0.1.0",
  "description": "Metodologia completa de gestão de conhecimento com LLM — inbox, ingest, query, lint, cross-ingest, git sync",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
