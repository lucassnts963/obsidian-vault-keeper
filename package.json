    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "obsidian": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "esbuild": "^0.23.0",
    "builtin-modules": "^4.0.0"
  }
}
